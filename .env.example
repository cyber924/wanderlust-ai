# Cloudflare Worker runtime secrets are configured in the Cloudflare dashboard.
# Do not put GEMINI_API_KEY in VITE_* variables or expose it to browser code.
# Configure with: npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY="set-as-a-Worker-secret"

# wrangler.toml contains the D1 binding and database name.
# Replace database_id with the D1 database ID from Cloudflare.
