/**
 * @file Firestore Security Rules for PixelStory & Wanderlust AI
 * 
 * 모든 사용자가 데이터를 자유롭게 읽을 수 있도록 전역 개방하며,
 * 쓰기 작업은 인증된 사용자 및 관리자(cyber924@naver.com, cyber924@gmail.com)에게 허용합니다.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // [1] 전역 읽기 권한: 비로그인 사용자 포함 모든 읽기(get, list)를 허용합니다.
    match /{document=**} {
      allow read: if true;
    }

    // [2] 관리자 권한
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "cyber924@naver.com" ||
        request.auth.token.email == "cyber924@gmail.com"
      );
    }

    // 사용자 프로필: 본인 또는 관리자만 수정 가능
    match /users/{userId} {
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 메인 컨텐츠 및 하위 컬렉션: 로그인한 사용자라면 누구나 작성 가능
    match /comics/{id} { allow write: if request.auth != null; }
    match /blogs/{id} { allow write: if request.auth != null; }
    match /travel_blog_posts/{id} { allow write: if request.auth != null; }
    match /fairy-tales/{id} { allow write: if request.auth != null; }
    match /images/{id} { allow write: if request.auth != null; }
    match /travel_gallery_images/{id} { allow write: if request.auth != null; }
    match /scheduled_queue/{id} { allow write: if request.auth != null; }
    
    // 댓글 작성 권한 상세
    match /comics/{id}/comments/{cid} { allow write: if request.auth != null; }
    match /blogs/{id}/comments/{cid} { allow write: if request.auth != null; }
    match /travel_blog_posts/{id}/comments/{cid} { allow write: if request.auth != null; }

    // 통계 및 시스템 권한
    match /statistics/{id} { allow write: if request.auth != null; }

    match /{document=**} {
      allow write, delete: if isAdmin();
    }
  }
}
